import 'package:flutter/material.dart';

void main() {
  runApp(MyApp());
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: ProductPage(),
      debugShowCheckedModeBanner: false,
    );
  }
}

class ProductPage extends StatefulWidget {
  @override
  _ProductPageState createState() => _ProductPageState();
}

class _ProductPageState extends State<ProductPage> {
  String selectedBrand = "Apple";

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Products"),
        backgroundColor: Colors.blue,
      ),
      body: ListView(
        children: [
          ProductBox(
            name: "iPhone 15",
            brand: selectedBrand,
            description: "High performance smartphone with A17 chip.",
            price: 4200,
            image: "assets/iphone.png",
          ),
          ProductBox(
            name: "Galaxy S24",
            brand: "Samsung",
            description: "Latest Samsung flagship with AI features.",
            price: 3800,
            image: "assets/s24.png",
          ),
          ProductBox(
            name: "Pixel 8",
            brand: "Google",
            description: "Clean Android experience with great camera.",
            price: 3500,
            image: "assets/pixel.png",
          ),
        ],
      ),
    );
  }
}

class ProductBox extends StatelessWidget {
  ProductBox({this.name, this.brand, this.description, this.price, this.image});

  final String name;
  final String brand;
  final String description;
  final int price;
  final String image;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: EdgeInsets.all(10),
      height: 150,
      child: Card(
        child: Row(
          children: [
            Image.asset(image, width: 120, height: 120),
            Expanded(
              child: Container(
                padding: EdgeInsets.all(10),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(name,
                        style: TextStyle(
                            fontSize: 20, fontWeight: FontWeight.bold)),
                    Text("Brand: $brand",
                        style: TextStyle(
                            fontSize: 16, fontWeight: FontWeight.w500)),
                    Text(description),
                    Text("Price: $price SAR",
                        style: TextStyle(
                            fontSize: 18, fontWeight: FontWeight.bold)),
                  ],
                ),
              ),
            )
          ],
        ),
      ),
    );
  }
}

